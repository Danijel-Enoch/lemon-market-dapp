{
	"name": "lemon-markets",
	"version": "0.2.0",
	"type": "module",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun run --filter '@lemon/web' dev",
		"dev:stack": "scripts/dev.sh",
		"dev:fork": "scripts/dev.sh .env.fork",
		"fork:up": "scripts/fork-up.sh",
		"fork:down": "scripts/fork-down.sh",
		"testnet:up": "scripts/testnet-up.sh",
		"dev:api": "bun run --filter '@lemon/api' dev",
		"dev:indexer": "bun run --filter '@lemon/indexer' dev",
		"dev:agent": "bun run --filter '@lemon/agent' dev",
		"build": "bun run --filter '@lemon/web' build && bun run --filter '@lemon/admin' build",
		"start": "bun run --filter '@lemon/web' start",
		"typecheck": "bun run --filter '*' typecheck",
		"lint": "biome check --write",
		"contracts:build": "bun run --filter '@lemon/contracts' build",
		"contracts:test": "bun run --filter '@lemon/contracts' test",
		"contracts:deploy": "bun run --filter '@lemon/contracts' deploy",
		"db:generate": "bun run --filter '@lemon/db' generate",
		"db:push": "bun run --filter '@lemon/db' push",
		"db:migrate": "bun run --filter '@lemon/db' migrate",
		"db:deploy": "bun run --filter '@lemon/db' deploy",
		"db:seed": "bun run --filter '@lemon/db' seed",
		"test": "bun test && bun run contracts:test",
		"dev:admin": "bun run --filter '@lemon/admin' dev",
		"build:web": "bun run --filter '@lemon/web' build",
		"build:admin": "bun run --filter '@lemon/admin' build",
		"start:admin": "bun run --filter '@lemon/admin' start"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.11",
		"@types/node": "^20.19.29",
		"typescript": "^5.9.3"
	},
	"packageManager": "bun@1.3.3",
	"dependencies": {
		"@openzeppelin/contracts": "^5.1.0"
	}
}
