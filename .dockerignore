# The build stage copies the installed node_modules from the `install` layer and
# then runs `COPY . .`. Without this file the host's node_modules lands on top of
# it — which on macOS means darwin-arm64 binaries (lightningcss, prisma engines)
# inside a linux image, and a ~2 GB build context on every build.
node_modules
**/node_modules

# Build output is produced inside the image.
build
**/build
dist
**/dist
apps/web/.react-router
**/.react-router
*.tsbuildinfo

# Never bake credentials into an image layer.
.env
.env.*
!.env.example

.git
.github
.gitignore
.claude
docs
README.md
*.md
!packages/**/*.md

# Local tooling and editor state.
.DS_Store
.vscode
.idea
coverage
.turbo
.cache
*.log

# Test output. `playwright-report` alone is 36 MB of screenshots and traces, and
# every byte of it is uploaded to the daemon on every build to be ignored by
# every stage.
playwright-report
test-results
.playwright

# Foundry's working directories. The image never compiles a contract — it reads
# `packages/contracts/ts/abi.ts`, which is generated ahead of time and committed
# — so the artifacts, the deploy logs and the forge-std submodule are all
# context that is copied and never opened.
packages/contracts/out
packages/contracts/cache
packages/contracts/broadcast
packages/contracts/lib
