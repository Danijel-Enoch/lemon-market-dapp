# Copy to .env and fill in. Every value below has a working default except
# RELAY_API_KEY and DATABASE_URL, which gate specific features rather than the
# whole app — the UI says so explicitly when they are missing.

# --- Database --------------------------------------------------------------
# Required for cash & carry (multi-leg positions must survive a reload) and
# deposit history. Without it those features report themselves as unavailable.
DATABASE_URL=postgresql://lemon:lemon@localhost:5432/lemon

# docker-compose reads these to provision Postgres.
POSTGRES_USER=lemon
POSTGRES_PASSWORD=lemon
POSTGRES_DB=lemon
POSTGRES_PORT=5432

# --- Chain -----------------------------------------------------------------
CHAIN_ID=8453
# A dedicated RPC is strongly recommended; the public endpoint rate-limits.
BASE_RPC_URL=https://mainnet.base.org

# --- Pacifica (perps) ------------------------------------------------------
PACIFICA_API_URL=https://api.pacifica.fi/api/v1

# --- KyberSwap (spot) ------------------------------------------------------
KYBER_BASE_URL=https://aggregator-api.kyberswap.com
# Identifies this app for rate limiting. Set something specific to your deploy.
KYBER_CLIENT_ID=lemon-markets

# --- Your fees -------------------------------------------------------------
# The two venues collect fees by different mechanisms, so they are configured
# separately. Leaving either group unset simply means no fee is charged there.
#
# SPOT: taken inside the KyberSwap route, so the quote the user sees is already
# net of it. Both the rate AND the receiver must be set — one without the other
# is treated as no fee, because a fee with no receiver would be burned.
#   bps: 100 = 1%. KyberSwap caps this at 2000 (20%).
SPOT_FEE_BPS=
SPOT_FEE_RECEIVER=
#   Which side the fee comes from. `currency_in` is charged before the swap and
#   is predictable; `currency_out` varies with the fill. Defaults to currency_in.
SPOT_FEE_CHARGE_BY=currency_in

# PERP: your registered Pacifica builder code, and the fee ceiling users are
# asked to approve. Both are required together; either alone disables
# attribution.
#
# Users must approve the code before any of their orders can carry it. That
# approval happens as part of "Activate trading" during onboarding, so it costs
# no extra wallet prompt — but the fee is named in the message they sign, and
# in the onboarding panel.
#
# PACIFICA_BUILDER_MAX_FEE_RATE is a decimal fraction, not a percentage:
# "0.001" is 0.1%. For scale, Pacifica's own tier-1 taker fee is 0.04%.
#
# Set it ABOVE the rate you actually charge. Pacifica REJECTS an order whose
# builder fee exceeds what the user approved — it does not fill it
# unattributed — so raising your registered rate past an approved ceiling stops
# those users trading until they re-approve. The app detects that and prompts,
# but headroom avoids the situation entirely. Values above 0.01 (1%) are
# refused as a likely typo.
PACIFICA_BUILDER_CODE=
PACIFICA_BUILDER_MAX_FEE_RATE=

# --- Relay (cross-chain deposits) ------------------------------------------
RELAY_API_URL=https://api.relay.link
# Required for deposit addresses. Free and self-serve at dashboard.relay.link.
# Without it Relay silently returns an ordinary quote with no deposit address,
# so the app disables the feature and explains why rather than showing an empty
# screen.
RELAY_API_KEY=

# --- Accounts (sign-in, derived wallets, Pacifica trading) ------------------
# All three of the below are required together. Without them the app still
# serves market data and the connected-wallet view, but sign-in reports itself
# unavailable and names the missing piece — nothing fails silently.

# Signs session cookies and encrypts stored Pacifica agent keys at rest.
# Must be at least 32 characters. Generate one with `openssl rand -base64 32`.
#
# Rotating it invalidates every stored agent key: users have to re-activate,
# which costs them a signature but loses no funds.
AUTH_SECRET=

# NEAR chain signatures, which hold each user's derived EVM and Solana wallets.
#
# NEAR_ACCOUNT_ID is an input to address derivation, so changing it after users
# exist repoints all of them at fresh, empty wallets while their balances stay
# at addresses nothing derives any more. Choose it once and treat it as
# permanent. The account needs a small NEAR balance: every signature it
# requests is an on-chain function call.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NEAR_NETWORK=mainnet
# Optional overrides. The defaults are v1.signer on the chosen network and the
# public NEAR RPC; a private RPC is worth having under load.
NEAR_RPC_URL=
NEAR_MPC_CONTRACT_ID=

# --- Solana (Pacifica deposits) ---------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# A funded Solana keypair, base58, that pays network fees for deposits.
#
# Crediting a deposit is a transaction signed by the user's derived wallet,
# which holds USDC and no SOL, so it cannot pay its own fee. This account covers
# that and the one-off rent for a user's first USDC token account. It is never
# an authority over user funds. A few SOL covers a great many deposits.
SOLANA_FEE_PAYER_SECRET=

# --- Web -------------------------------------------------------------------
PORT=3002
API_PORT=3003
VITE_API_BASE_URL=/api
VITE_WALLETCONNECT_PROJECT_ID=
# Optional: overrides the browser's Base RPC. Leave blank to use the default.
VITE_BASE_RPC_URL=

# --- Deployment (docker-compose.dokploy.yml) --------------------------------
# The hostname Traefik routes to. Required by the Dokploy compose file; unused
# by the local one, which publishes ports directly instead.
DOMAIN=
# Only needed with the `split` profile, which runs the API as its own service.
# Defaults to api.${DOMAIN}.
API_DOMAIN=
# Host port for the local compose file. Change it if 3002 is already taken.
WEB_PORT=3002
