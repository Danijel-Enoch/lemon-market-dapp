# Copy to .env and fill in. Every value below has a working default except
# RELAY_API_KEY and DATABASE_URL, which gate specific features rather than the
# whole app — the UI says so explicitly when they are missing.

# --- Logging ---------------------------------------------------------------
# Applies to every process: the API, the agent, the indexer and the web app.
#
# `info` — the default — is one line per API request, and for the agent a
# running commentary: each cycle starting and ending with its duration, what
# each vault observed, the action it chose, every leg of a deployment or unwind,
# and a heartbeat while a bridge is in flight.
#
# `debug` adds the per-step detail: each request as it arrives, the four phases
# of a tick, the venue calls inside them, and the Relay poll results. Useful
# when a tick is not doing what you expect; noisy otherwise.
LOG_LEVEL=info

# Set to `json` for one JSON object per line, for a log shipper. Anything else
# (including empty) gives the human-readable form, coloured on a TTY.
LOG_FORMAT=

# --- Database --------------------------------------------------------------
# Holds sessions, the admin allowlist, per-vault venue configuration and the
# agents' decision log. Nothing a user's balance depends on: vaults, shares and
# the withdrawal queue live on Base.
DATABASE_URL=postgresql://lemon:lemon@localhost:5432/lemon

# docker-compose reads these to provision Postgres.
POSTGRES_USER=lemon
POSTGRES_PASSWORD=lemon
POSTGRES_DB=lemon
POSTGRES_PORT=5432

# --- Chains ----------------------------------------------------------------
# Three chains are known to this build: Base (8453), Arbitrum One (42161) and
# X Layer (196). The set is not configurable — it is a closed list in
# packages/core/src/chain.ts — but *which* of them this deployment runs is, and
# the switch is the factory address: a chain with no VAULT_FACTORY_ADDRESS_<CHAIN>
# is not indexed, not offered in the app, and not something a vault can be
# created on. Leave the ones you are not using blank.
#
# Variables are suffixed _BASE, _ARBITRUM or _XLAYER. The unsuffixed names below
# still work and still mean Base, so an .env from before this existed keeps
# working unchanged — but they are Base-only and never fall through to another
# chain, because a chain reading another's endpoint would index a chain with no
# factory on it and serve an empty app.
#
# A dedicated RPC is strongly recommended; the public endpoints rate-limit.
RPC_URL_BASE=https://mainnet.base.org
RPC_URL_ARBITRUM=https://arb1.arbitrum.io/rpc
RPC_URL_XLAYER=https://rpc.xlayer.tech

# The name that existed when Base was the only chain. Still read, still Base.
BASE_RPC_URL=https://mainnet.base.org

# Further endpoints per chain, comma separated. The API tries them in order when
# the primary fails, including on a 429; the indexer spreads its load across all
# of them at once. Left empty on purpose: a deployment that points its RPC at its
# own provider should not inherit a fallback it did not choose.
#
# Use endpoints with API keys. The well-known keyless Base ones were tested
# against the multi-address eth_getLogs the indexer follows vaults with, and
# every one of them failed it — two with -32602, which the indexer cannot retry
# and exits on. See apps/indexer/src/rpc.ts for the results. The Arbitrum and
# X Layer defaults have NOT been through that test; send them the same request
# before trusting either with a backfill.
BASE_RPC_FALLBACK_URLS=
ARBITRUM_RPC_FALLBACK_URLS=
XLAYER_RPC_FALLBACK_URLS=

# Whether reads may be sent as JSON-RPC batches. On unless set to 0/false.
# Only turn this off for a provider that rejects batched payloads — on those the
# failure is total, not partial, so it looks like the node is down.
# RPC_BATCH applies to every chain; BASE_RPC_BATCH is the older, Base-only name.
RPC_BATCH=
BASE_RPC_BATCH=

# --- Pacifica (perps) ------------------------------------------------------
# The perp leg. Deposits are an Anchor instruction whose program addresses are
# Solana mainnet-beta only, so SOLANA_RPC_URL has to point at the same cluster.
PACIFICA_API_URL=https://api.pacifica.fi/api/v1

# --- Spot aggregators ------------------------------------------------------
# One per chain, chosen by which one actually covers it. KyberSwap routes Base
# and Arbitrum; it has no X Layer deployment at all, and no routing service
# covers that chain's tokens either, so X Layer reads Uniswap V3 directly
# (packages/univ3). Nothing here selects the aggregator — that is a fact about
# the chain, decided in apps/api/src/config.ts.
KYBER_BASE_URL=https://aggregator-api.kyberswap.com
# Identifies this app for rate limiting. Set something specific to your deploy.
KYBER_CLIENT_ID=lemon-markets

# LI.FI. No chain in this build routes through it today.
#
# It used to route X Layer, on the understanding that it reached that chain's
# Uniswap v3 pools through SushiSwap's aggregator. It does not: LI.FI answers
# "Could not find token on chain 196" for all fourteen tokens this app trades
# there, and returns "No available quotes" even between two tokens it does list
# on the chain. X Layer now reads those pools directly — see packages/univ3 —
# and needs no key or quota to do it.
#
# Kept configured because LI.FI remains the sensible first thing to try for a
# fourth chain, before writing another venue adapter.
LIFI_BASE_URL=https://li.quest
LIFI_INTEGRATOR=lemon-markets
LIFI_API_KEY=

# --- Vault contracts, per chain ---------------------------------------------
# Written by `CHAIN=<base|arbitrum|xlayer> scripts/deploy-contracts.sh`. One run
# per chain; the contracts are identical, the addresses are not.
#
# For X Layer, `scripts/deploy-xlayer.sh` runs that and then walks the rest of
# the wiring — the browser's copy of the factory, the indexer's endpoint and
# start block, the agent's chain — because those live in four more variables
# below and every one of them fails silently rather than loudly when unset.
#
# A factory address here is what *enables* a chain. Without one the admin
# dashboard can read the market board but cannot create a vault on that chain,
# and it says so rather than failing at signing time.
VAULT_FACTORY_ADDRESS_BASE=
VAULT_FACTORY_ADDRESS_ARBITRUM=
VAULT_FACTORY_ADDRESS_XLAYER=

INSURANCE_FUND_ADDRESS_BASE=
INSURANCE_FUND_ADDRESS_ARBITRUM=
INSURANCE_FUND_ADDRESS_XLAYER=

# The block each factory was deployed in. The indexer starts there rather than
# at genesis; indexing any of these chains from block 0 is hours of RPC for
# nothing, and on a busy chain it reads as a hang rather than a missing value.
VAULT_FACTORY_START_BLOCK_BASE=
VAULT_FACTORY_START_BLOCK_ARBITRUM=
VAULT_FACTORY_START_BLOCK_XLAYER=

# Each chain's USDC — the vault's asset there. All three are six decimals, which
# the whole system assumes; the deploy script refuses anything else.
#   Base      Circle-issued, native
#   Arbitrum  Circle-issued native USDC, NOT the bridged USDC.e at
#             0xFF970A61... — that one also answers symbol() "USDC" with six
#             decimals and holds a fiftieth of the supply
#   X Layer   bridged; there is no Circle-native issuance on that chain. Note
#             that X Layer also carries 0x74b7F163... which answers symbol()
#             "USDC" with six decimals and is NOT this token — it holds a small
#             fraction of the supply. Nothing in this codebase can tell them
#             apart, so do not "fix" this address without checking the chain.
USDC_ADDRESS_BASE=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
USDC_ADDRESS_ARBITRUM=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
USDC_ADDRESS_XLAYER=0xB6CEceAB302E2E4948951eE7843FC24E92933061

# The unsuffixed names, kept working and still meaning Base.
VAULT_FACTORY_ADDRESS=
INSURANCE_FUND_ADDRESS=
VAULT_FACTORY_START_BLOCK=
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# Which chain THIS agent process serves. One process per chain: everything the
# agent does is bound to a single chain at once, and a process serving a vault
# from elsewhere would read zero balances and report a NAV that wipes out every
# holder's share price. Defaults to Base.
#
# So a second chain is a second process, not a second value. Under compose those
# are the `agent` and `agent-xlayer` services in docker-compose.dokploy.yml, and
# each one *pins* its own chain rather than reading this variable — otherwise a
# value set here would point both containers at the same chain, and two agents
# ticking one vault means duplicate deployments and two NAV reports racing.
#
# So this is read by a local `bun run dev:agent` and by nothing in production:
#
#   AGENT_CHAIN_ID=196 bun run dev:agent
AGENT_CHAIN_ID=8453

# Addresses granted to the deploy script. The admin is the vault admin on every
# vault the factory creates; the guardian can pause; the treasurer can move
# value out of the insurance fund.
VAULT_ADMIN_ADDRESS=
VAULT_GUARDIAN_ADDRESS=
INSURANCE_TREASURER_ADDRESS=

# --- Admin dashboard --------------------------------------------------------
# Comma-separated addresses seeded into the admin table at boot. This is the
# bootstrap only — admin membership lives in the database afterwards, so
# removing an address here does not revoke it.
ADMIN_ADDRESSES=

# --- Indexer ----------------------------------------------------------------
# Ponder serves every historical number the app shows: balances, the withdrawal
# queue, the activity feed and the share-price series. The API proxies it, so the
# browser never talks to it directly.
INDEXER_URL=http://localhost:42069
# The indexer's own RPC endpoints, comma separated. Replaces BASE_RPC_URL when
# set; BASE_RPC_FALLBACK_URLS is added either way.
#
# Give it more than one, and give it keys. Ponder measures each endpoint's real
# rate limit and spreads the backfill across them, so a second URL is close to
# twice the throughput — while a single public node is throttled to a few
# requests a second and then logs "Unable to find available JSON-RPC provider"
# every fifteen seconds, forever, with nothing else to fall back to.
PONDER_RPC_URL_BASE=
PONDER_RPC_URL_ARBITRUM=
PONDER_RPC_URL_XLAYER=

# --- Agent ------------------------------------------------------------------
# Seconds between ticks per vault. Each tick reads both venues and may report a
# valuation, so this interacts with the vault's own minNavReportInterval.
AGENT_TICK_INTERVAL_MS=60000

# Where the agent and scripts/seed-venue-config.ts reach the API. The vault list
# and every venue read go through it, so this is the one address the agent needs.
AGENT_API_URL=http://localhost:3002/api

# How long the agent waits for a Relay fill before giving up on a crossing, in
# milliseconds. Giving up does not cancel anything — the transfer stays recorded
# as in flight and keeps counting towards NAV — it only stops the tick.
BRIDGE_FILL_TIMEOUT_MS=1200000

# How long the agent waits for a Pacifica withdrawal to reach its Solana wallet
# before the same. Pacifica settles on its own schedule, and the request has
# already been accepted by the time this matters.
VENUE_WITHDRAWAL_TIMEOUT_MS=900000

# Slippage tolerance written into each vault's venue config by
# scripts/seed-venue-config.ts, in percent. Read only at seed time.
AGENT_SLIPPAGE_PERCENT=0.5

# The smallest spot leg the agent will open, in dollars. Measured on the spot
# leg, not on the deployment that funds it — at 1x a deployment buys a spot leg
# half its size, so the idle balance a vault needs before it can trade at all is
# roughly this figure times (L+1)/L, divided by the vault's maxDeployedBps.
#
# Below the floor a Kyber swap pays more in fees and pool slippage than the
# hedge it buys earns back in funding, so lowering it does not unlock capital so
# much as spend it. Both the policy and the venue adapter read this value.
MIN_DEPLOY_USDC=30

# How far below its ceiling the agent opens a hedge, in basis points.
#
# The leverage the contract stores is marked to market on both sides — notional
# grows as the underlying rises and equity falls by the same dollars — so a
# hedge opened at exactly its ceiling breaches on a fraction of a percent, and
# on the opening taker fee before that. A conservative vault has no headroom of
# its own (the contract requires its target and ceiling to both be 1x), so the
# room has to come out of the sizing.
#
# A buffer of b absorbs a move of b / (2 * (1 - b)): 300 bps covers about 1.55%,
# which is a normal day for a tokenised equity. The cost is that the same dollar
# buys that much less spot leg, and funding is earned on the spot leg. A vault
# whose ceiling already sits above its target is left at its target.
MARGIN_BUFFER_BPS=300

# The smallest margin top-up worth bridging, in dollars.
#
# Restoring a buffer eaten by a small move can be a shortfall of cents, and
# bridging cents every tick costs more than the vault earns. A top-up sends at
# least this much even when less would do; the excess is equity, it lands the
# account further below its ceiling rather than above it, and the next
# deployment picks it up. Worth lowering for a small vault, where $5 is a large
# share of the position.
MIN_TOP_UP_USDC=5

# OpenRouter powers the agent's timing judgement. Optional: with no key the
# agent runs on its deterministic policy alone, which is strictly less clever and
# equally safe — the model can only ever pick among actions the policy already
# cleared, and can never produce an amount.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_REFERER=

# --- Your fees -------------------------------------------------------------
# The two venues collect fees by different mechanisms, so they are configured
# separately. Leaving either group unset simply means no fee is charged there.
#
# SPOT: taken inside the KyberSwap route, so the quote the user sees is already
# net of it. Both the rate AND the receiver must be set — one without the other
# is treated as no fee, because a fee with no receiver would be burned.
#   bps: 100 = 1%. KyberSwap caps this at 2000 (20%).
SPOT_FEE_BPS=
SPOT_FEE_RECEIVER=
#   Which side the fee comes from. `currency_in` is charged before the swap and
#   is predictable; `currency_out` varies with the fill. Defaults to currency_in.
SPOT_FEE_CHARGE_BY=currency_in

# Note that this now applies to the *agent's* swaps rather than to a user's, so
# it comes out of vault performance. It is disclosed on the vault page alongside
# the management and performance fees for that reason.

# --- Pacifica builder code (perp fees) --------------------------------------
# Your registered builder code, and the fee ceiling users are asked to approve.
# Both are required together; either alone disables attribution.
#
# Users must approve the code before any of their orders can carry it. That
# approval happens as part of "Activate trading" during onboarding, so it costs
# no extra wallet prompt — but it does mean the fee is named in the message they
# sign, and in the onboarding panel.
#
# PACIFICA_BUILDER_MAX_FEE_RATE is a decimal fraction, not a percentage:
# "0.001" is 0.1%. For scale, Pacifica's own tier-1 taker fee is 0.04%.
#
# Set it ABOVE the rate you actually charge. Pacifica rejects an order whose
# builder fee exceeds what the user approved — it does not fill it
# unattributed — so raising your registered rate past an approved ceiling stops
# those users trading until they re-approve. Values above 0.01 (1%) are refused
# as a likely typo.
PACIFICA_BUILDER_CODE=
PACIFICA_BUILDER_MAX_FEE_RATE=

# --- Relay (cross-chain deposits) ------------------------------------------
RELAY_API_URL=https://api.relay.link
# Required for deposit addresses. Free and self-serve at dashboard.relay.link.
# Without it Relay silently returns an ordinary quote with no deposit address,
# so the app disables the feature and explains why rather than showing an empty
# screen.
RELAY_API_KEY=

# --- Sign-in ----------------------------------------------------------------
# Optional for users: depositing and withdrawing are ordinary wallet
# transactions. A session gates the admin dashboard and saves typing an address
# on the portfolio page, and nothing else.

# Signs session cookies. At least 32 characters; `openssl rand -base64 32`.
# Rotating it logs everyone out and costs nobody anything.
AUTH_SECRET=

# NEAR chain signatures, which hold every *vault agent's* wallets.
#
# NEAR_ACCOUNT_ID is an input to address derivation, so changing it after vaults
# exist repoints every agent at fresh, empty wallets while the positions stay at
# addresses nothing derives any more — and a vault's agent address is immutable,
# so those vaults would be permanently unable to trade. Choose it once and treat
# it as permanent. The account needs a NEAR balance: every signature the agents
# request is an on-chain function call, and they sign continuously.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=
NEAR_NETWORK=mainnet

# One access key per agent process, on the same NEAR account.
#
# Needed once more than one chain's agent runs at a time. Every signature is a
# NEAR transaction from one access key, and the client serialises them with an
# in-memory queue — which two containers cannot share. Two agents on one key
# race on the nonce and one of each pair is rejected as a duplicate; during an
# unwind that is a leg that did not close.
#
# Nonces are per access key, so a second key on the SAME account separates them.
# It changes no addresses: a vault's agent wallet is derived from
# NEAR_ACCOUNT_ID and the path, never from the key that authorises the call.
#
#   near account add-key <NEAR_ACCOUNT_ID> grant-full-access \
#     autogenerate-new-keypair print-to-terminal network-config mainnet sign-with-keychain send
#
# Each falls back to NEAR_PRIVATE_KEY above, so a single-chain deployment needs
# neither. Keep both funded — signing is an on-chain call.
NEAR_PRIVATE_KEY_BASE=
NEAR_PRIVATE_KEY_XLAYER=
# Optional overrides. The defaults are v1.signer on the chosen network and the
# public NEAR RPC; a private RPC is worth having under load.
NEAR_RPC_URL=
NEAR_MPC_CONTRACT_ID=

# --- Solana (the perp leg) --------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# A funded Solana keypair, base58, that pays network fees for the agents.
#
# An agent's derived Solana wallet holds USDC and no SOL, so it cannot pay for
# its own transactions. This account covers that and the one-off rent for each
# agent's first USDC token account. It is never an authority over vault funds.
SOLANA_FEE_PAYER_SECRET=

# --- Web -------------------------------------------------------------------
PORT=3002
API_PORT=3003
VITE_API_BASE_URL=/api
VITE_WALLETCONNECT_PROJECT_ID=
# Optional: overrides the browser's Base RPC. Leave blank to use the default.
VITE_BASE_RPC_URL=
# Optional: the RPC endpoint the browser uses for Base mainnet. The chain itself
# is not configurable — a wallet on any other network gets the "wrong network"
# banner and an offer to switch.
VITE_CHAIN_RPC_URL=
# The factory the admin dashboard sends its createVault transaction to. Must
# match VAULT_FACTORY_ADDRESS_<CHAIN>; it is duplicated because the browser
# needs it and
# server-only values are deliberately not exposed to the bundle.
VITE_VAULT_FACTORY_ADDRESS=
# Per chain. As on the server, a factory address here is what makes a chain
# appear in the app at all — the network switcher offers exactly the chains that
# have one, so a chain listed with nothing deployed on it cannot be reached.
VITE_VAULT_FACTORY_ADDRESS_BASE=
VITE_VAULT_FACTORY_ADDRESS_ARBITRUM=
VITE_VAULT_FACTORY_ADDRESS_XLAYER=

# Browser-side RPC endpoints, per chain. VITE_CHAIN_RPC_URL and
# VITE_BASE_RPC_URL are the older names and still mean Base.
VITE_RPC_URL_BASE=
VITE_RPC_URL_ARBITRUM=
VITE_RPC_URL_XLAYER=
# Absolute origin for Farcaster Mini App embed metadata. The image, splash and
# launch URLs in an embed must be absolute, so a relative base will not serve.
# Leave blank locally; set it to the deployed origin in production.
VITE_APP_URL=

# --- Admin console ----------------------------------------------------------
# Its own app on its own port, so it can sit behind a VPN or an SSO proxy while
# the public app faces the internet. It mounts the same API, so it needs the same
# DATABASE_URL, AUTH_SECRET and ADMIN_ADDRESSES as above.
ADMIN_PORT=3004
# Where the console links out to for vault pages. It renders none of its own.
VITE_PUBLIC_APP_URL=http://localhost:3002

# --- Tests ------------------------------------------------------------------
# Where the Playwright suite points. The defaults match `bun run dev`, so these
# only need setting to run the suite against something other than a local server.
E2E_WEB_URL=http://localhost:3002
E2E_ADMIN_URL=http://localhost:3004
# Set to 1 to log every JSON-RPC method the page asks the stub wallet for. Worth
# it when a test fails because the app requested something the stub cannot answer.
E2E_WALLET_DEBUG=

# The venue packages ship tests that hit the real APIs. They are skipped unless
# these are set to 1, which keeps the default suite offline and deterministic.
PACIFICA_LIVE=
NEAR_LIVE=

# --- Deployment (docker-compose.dokploy.yml) --------------------------------
# The hostname Traefik routes to. Required by the Dokploy compose file; unused
# by the local one, which publishes ports directly instead.
DOMAIN=
# The hostname for the standalone `api` service, which deploys alongside the web
# app. Defaults to api.${DOMAIN}. Leaving it unresolved is harmless — the router
# never matches, and the service stays reachable inside the compose network.
API_DOMAIN=
# Host port for the local compose file. Change it if 3002 is already taken.
WEB_PORT=3002
