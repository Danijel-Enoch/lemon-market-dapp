		"/positions/query": {
			"post": {
				"parameters": [],
				"operationId": "postPositionsQuery",
				"summary": "Query Positions with Filters",
				"description": "Query positions from the subgraph with optional filters (trader, tokenSymbol, status, isLong, etc.)",
				"tags": ["Query"],
				"requestBody": {
					"required": true,
					"content": {
						"application/json": {
							"schema": {
								"type": "object",
								"properties": {
									"trader": {
										"pattern": "^0x[a-fA-F0-9]{40}$",
										"type": "string"
									},
									"tokenSymbol": {
										"minLength": 1,
										"type": "string"
									},
									"status": {
										"anyOf": [
											{
												"const": "OPEN",
												"type": "string"
											},
											{
												"const": "CLOSED",
												"type": "string"
											},
											{
												"const": "LIQUIDATED",
												"type": "string"
											}
										]
									},
									"isLong": {
										"type": "boolean"
									},
									"limit": {
										"minimum": 1,
										"maximum": 1000,
										"type": "number"
									},
									"offset": {
										"minimum": 0,
										"type": "number"
									}
								}
							}
						},
						"multipart/form-data": {
							"schema": {
								"type": "object",
								"properties": {
									"trader": {
										"pattern": "^0x[a-fA-F0-9]{40}$",
										"type": "string"
									},
									"tokenSymbol": {
										"minLength": 1,
										"type": "string"
									},
