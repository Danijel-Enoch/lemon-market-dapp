											{
												"const": "OPEN",
												"type": "string"
											},
											{
												"const": "CLOSED",
												"type": "string"
											},
											{
												"const": "LIQUIDATED",
												"type": "string"
											}
										]
									},
									"isLong": {
										"type": "boolean"
									},
									"limit": {
										"minimum": 1,
										"maximum": 1000,
										"type": "number"
									},
									"offset": {
										"minimum": 0,
										"type": "number"
									}
								}
							}
						},
						"text/plain": {
							"schema": {
								"type": "object",
								"properties": {
									"trader": {
										"pattern": "^0x[a-fA-F0-9]{40}$",
