{
	"name": "@lemon/db",
	"version": "0.2.0",
	"type": "module",
	"private": true,
	"main": "./src/index.ts",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"generate": "prisma generate",
		"migrate": "bun --env-file=../../.env ../../node_modules/.bin/prisma migrate dev",
		"deploy": "bun --env-file=../../.env ../../node_modules/.bin/prisma migrate deploy",
		"seed": "bun --env-file=../../.env run ./src/seed.ts",
		"studio": "bun --env-file=../../.env ../../node_modules/.bin/prisma studio",
		"typecheck": "tsc --noEmit",
		"push": "bun --env-file=../../.env ../../node_modules/.bin/prisma db push"
	},
	"dependencies": {
		"@lemon/core": "workspace:*",
		"@prisma/client": "^6.19.0",
		"@lemon/registry": "workspace:*",
		"@lemon/pacifica": "workspace:*"
	},
	"devDependencies": {
		"prisma": "^6.19.0"
	},
	"prisma": {
		"schema": "./prisma/schema.prisma"
	}
}
