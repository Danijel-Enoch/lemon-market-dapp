// Persistence for state that cannot be reconstructed from chain or upstream APIs.
//
// Narrower than it looks, because most of what the app shows is not here. The
// vaults, their balances, every deposit and withdrawal and every action the
// agents took live on Base and are read through Ponder — a database that can be
// dropped and rebuilt from events. This one holds the five things that genuinely
// cannot be:
//
//   1. Sessions and the wallets they are bound to.
//   2. Which addresses may administer the protocol.
//   3. The venue configuration a vault trades against, which is a curated
//      mapping from a market to a specific token and perp and is not on-chain.
//   4. Verdicts from verifying agent activity against other chains, which are
//      the product of round trips that a reindex would otherwise discard.
//   5. The last funding total read off the venue, which is the previous half of
//      a subtraction whose result is the only part the chain ever sees.
//
// Nothing a user's balance depends on is stored here. Losing this database
// costs sessions and operator configuration; it cannot cost anyone their funds.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cached registry of spot legs — Coinbase B20 tokenized stocks and the Base
/// ERC-20s that match a listed perp — plus their live routability.
model SpotAsset {
  symbol           String   @id
  ticker           String   @unique
  name             String
  address          String   @unique
  decimals         Int
  /// The perp market that hedges this token, resolved by ticker against the
  /// live catalog and refreshed on sync. Null means nothing lists a match, so
  /// the token has no basis market.
  perpSymbol String?

  /// Whether KyberSwap can currently route into / out of this token. This is
  /// live market state, not configuration — most of these tokens have no
  /// Aerodrome pool yet, and that changes without notice.
  buyable              Boolean  @default(false)
  sellable             Boolean  @default(false)
  buyPriceImpactPct    Float?
  /// Executable USD price from the last buy probe, which is what the basis is
  /// measured against.
  spotPriceUsd         Float?
  routabilityCheckedAt DateTime?

  updatedAt DateTime @updatedAt

  @@index([buyable])
}

/// Periodic funding snapshots, so a market's APR can be shown as a trend rather
/// than a single instantaneous reading that swings with open interest.
model FundingSnapshot {
  id           String   @id @default(cuid())
  pairIndex    Int
  symbol       String
  /// Percent per hour. Positive = the side receives, negative = it pays.
  longRatePct  Float
  shortRatePct Float
  longOi       Float
  shortOi      Float
  capturedAt   DateTime @default(now())

  @@index([symbol, capturedAt])
  @@index([pairIndex, capturedAt])
}

/// The last cumulative funding figure read off the venue for one vault's perp,
/// so the next reading can be turned into a payment.
///
/// The venue reports funding as a running total on the *open position*, and what
/// belongs in the activity feed is the amount that arrived at one settlement —
/// the difference between two readings. Something has to remember the previous
/// one, and it cannot be memory: an agent restart would re-baseline against a
/// total that already includes hours of funding, and the vault would silently
/// report zero funding for the period it was restarted in.
///
/// It cannot be the chain either, which is the reason this is here rather than
/// derived like almost everything else. The figure needed is the venue's running
/// total, and the chain only ever sees the differences we compute from it.
///
/// Losing this table costs at most one period of funding per market — the next
/// tick re-baselines and carries on. It cannot cost anyone their funds, and the
/// funding already reported stays on-chain where it was recorded.
model FundingWatermark {
  /// Lowercased, matching every other vault address in this schema.
  vaultAddress String

  /// The venue's symbol for the perp, e.g. "BTC". Not the vault's ticker: the
  /// reading being watermarked is the venue's, and only its own name for the
  /// market can be matched back to it.
  perpSymbol String

  /// Cumulative funding on the open position, in signed USDC base units. A
  /// string because six-decimal amounts are exact as integers and lossy as
  /// doubles, and negative because a short does not only ever receive.
  accruedUsdc String

  /// The venue's `created_at` for the position this total belongs to.
  ///
  /// The reset detector. Funding accrues on a position, not on a vault, so
  /// closing and reopening starts the total again from zero — and without an
  /// identity to compare, a fresh position reads as an enormous negative
  /// payment. A change here means the previous total ended and the current one
  /// is the whole of the new position's accrual.
  positionOpenedAt Int

  updatedAt DateTime @updatedAt

  @@id([vaultAddress, perpSymbol])
}

// ---------------------------------------------------------------------------
// Accounts
//
// Sign-in exists to answer one question: which wallet is this. Users do not
// trade through the app any more — they deposit USDC into a vault and hold an
// ERC-20 share, both of which are ordinary wallet actions needing no session at
// all. What a session gates is the admin dashboard, and the convenience of
// showing someone their own portfolio without typing an address.
//
// So unlike the previous design, losing this table locks nobody out of
// anything. A user's position is their share balance on Base; it is theirs
// whether or not this database exists.
// ---------------------------------------------------------------------------

/// A signed-in user, keyed by the wallet they connect with.
model User {
  id String @id @default(cuid())

  /// The connected wallet, lowercased. This is the user's identity everywhere
  /// in the app; the derived addresses below are infrastructure they never see.
  address String @unique

  /// Whether this address is an admin, denormalised from `AdminUser` so the
  /// session lookup does not need a second query on every request.
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

/// A browser session, established by a wallet signature.
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the bearer token. The token itself is never stored, so a
  /// database leak cannot be replayed as a live session.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A one-time challenge, issued before each signature the app asks for.
///
/// Single-use and short-lived: without this a captured signature would be a
/// permanent credential, replayable by anyone who saw it once.
model SignInNonce {
  nonce String @id

  /// Lowercased wallet the challenge was issued to.
  address String
  /// Which step the challenge is for. Kept even though sign-in is currently the
  /// only purpose: a challenge issued for one action must never be replayable as
  /// another, and adding the field back later means migrating live nonces.
  purpose String

  /// The exact text the wallet was asked to sign.
  ///
  /// Stored rather than reconstructed at verification time. The message embeds
  /// a timestamp, and rebuilding it means reproducing that timestamp to the
  /// millisecond — a signature that fails to verify because two clocks
  /// disagree is indistinguishable from an attack.
  message String

  /// Sealed state a challenge carries between the two requests it spans.
  payload String?

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Vaults
//
// The on-chain vault is the source of truth for money. What it cannot hold is
// which *actual assets* a market means — the vault knows `keccak256("NVDA")`
// and nothing else, and resolving that to a Base ERC-20 and a Pacifica symbol
// is a curated decision that must not be guessable from a ticker.
// ---------------------------------------------------------------------------

enum RiskTier {
  CONSERVATIVE
  LEVERAGED
}

/// What kind of thing a vault trades.
///
/// Finer than the four tabs the board shows, because metals and commodities are
/// genuinely different instruments even though a depositor choosing a vault
/// groups them together. `@lemon/core` owns the mapping from these to tabs.
enum VaultAssetClass {
  CRYPTO
  EQUITY
  RWA
  FX
  COMMODITY
  METAL
  INDEX
  UNKNOWN
}

/// Venue configuration for one deployed vault, and the record of how it was created.
///
/// The pairing here is by asset, never by ticker match. A plain symbol lookup
/// against a Base token list returns an unrelated Base-native token for
/// FARTCOIN, a governance token for DOGE, and a different issuer's tokenized
/// stock for STRK — each of which would hedge a vault against the wrong asset
/// while every dashboard read healthy. The agent refuses to trade a vault with
/// no row here rather than resolving one itself.
model VaultConfig {
  /// The deployed vault address, lowercased.
  ///
  /// Not an id on its own any more, and the reason is not theoretical. A vault
  /// address is `CREATE`-derived from the factory's address and nonce, and the
  /// factories are themselves deployed from one deployer at matching nonces — so
  /// the *same* address on two chains is the likely case, not the unlikely one.
  /// Keyed by address alone, the second chain's first vault would either collide
  /// on insert or, worse, silently update the first chain's row.
  address String

  /// Which chain this vault is deployed on. See `CHAIN_REGISTRY` in `@lemon/core`.
  ///
  /// Defaulted to Base so the migration that adds this column is a backfill
  /// rather than a rewrite: every row that existed before there was a second
  /// chain was, in fact, on Base. New rows always set it explicitly.
  chainId Int @default(8453)

  /// Ticker the vault was created for, e.g. "NVDA". `keccak256` of this is the
  /// on-chain `marketId`, which is one-way — so this is the only place the
  /// human-readable name survives.
  ticker String

  riskTier RiskTier

  /// Set when the vault is created, from the market it was created for. Null
  /// falls back to the curated ticker table in `@lemon/core`, so an older row
  /// still lands in the right tab.
  assetClass VaultAssetClass?

  /// The NEAR derivation path this vault's agent wallet lives at. Recorded
  /// rather than recomputed so a change to the derivation scheme is visible as
  /// a mismatch instead of silently repointing an agent at empty wallets.
  ///
  /// Globally unique, not unique-per-chain, and that is deliberate. The
  /// derivation path already carries the chain (see `agentDerivationPath`), so
  /// two chains produce two different paths and two different wallets. Leaving
  /// the constraint global means that if a path ever *did* repeat across chains,
  /// the insert fails loudly here instead of quietly pointing two vaults' books
  /// at one signing key — which is the failure this constraint exists to catch,
  /// and scoping it per-chain would switch it off exactly when it fires.
  agentPath       String @unique
  agentEvmAddress String @unique
  agentSolanaAddress String @unique

  /// The Base ERC-20 that is the spot leg, and its decimals.
  ///
  /// The vault's *founding* market. A vault may now run several — see
  /// `VaultMarket`, which is what the agent actually reads — but these columns
  /// stay because they are how every vault created before that existed is
  /// described, and `markets` is seeded from them the first time a vault is
  /// loaded. Treat them as the seed, not as the position.
  spotTokenAddress  String
  spotTokenDecimals Int
  spotTokenSymbol   String

  /// What Pacifica accepts on the wire for the perp leg, e.g. "NVDA".
  perpSymbol String

  /// Slippage the agent trades with, as a percent. 0.5 means 0.5%.
  slippagePercent Float @default(0.5)

  /// How far the two legs of a hedge may drift apart before the agent corrects
  /// it, in basis points. 500 is 5%.
  ///
  /// Per vault rather than a constant because the right number depends on the
  /// size of the position, and it is two separate costs that set it. Below this
  /// the correction costs more in fees than the drift costs in exposure: a
  /// rebalance is a taker fill charged on the notional it trades, so chasing a
  /// fraction of a percent of delta with one is churn rather than risk
  /// management.
  ///
  /// The default is 5% and not the 1% a fee argument alone would suggest,
  /// because the venue has a floor of its own that a drift threshold cannot see:
  /// Pacifica rejects any perp order worth less than $10 of notional. On a small
  /// position the corrections a tighter threshold asks for are not placeable at
  /// all, and the agent would offer a rebalance every tick that the venue
  /// refuses every time. Raising the threshold does not hide that — the drift,
  /// the threshold and the reason a correction is unplaceable are all published
  /// on the vault page — it just stops the agent acting on a gap it cannot close.
  rebalanceDriftBps Int @default(500)

  /// Set when an operator has deliberately stopped the agent trading this vault
  /// without pausing the contract, which would also stop users depositing.
  agentEnabled Boolean @default(true)

  // -------------------------------------------------------------------------
  // The standing close order
  //
  // An operator telling the agent to flatten everything and send the money home
  // is not the same instruction as `agentEnabled = false`, and conflating them
  // was the tempting mistake. A stopped agent stops *reporting*, which stales
  // the NAV and blocks deposits and — worse — blocks the withdrawal queue it was
  // stopped in order to serve. An agent under a close order keeps ticking: it
  // reports NAV, it fulfils redemptions, it simply holds no position and opens
  // no new one.
  //
  // The order also has to be *standing* rather than a one-shot task. A flag that
  // cleared itself the moment the position went flat would have the very next
  // tick see idle USDC, decide it should be earning, and undo the whole thing.
  // So it stays set until an operator lifts it, and `closeCompletedAt` records
  // when the agent first reported the position actually flat.
  // -------------------------------------------------------------------------

  /// When an operator ordered every position closed and all capital returned.
  /// Null means no order stands.
  closeRequestedAt DateTime?
  /// The admin address that gave the order, lowercased.
  closeRequestedBy String?
  /// Why, in the operator's own words. Shown beside the order and kept after it
  /// is lifted, because "who unwound this vault in March and why" is a question
  /// that gets asked long after the answer has left anyone's memory.
  closeReason      String?
  /// When the agent first found the position flat under this order. Cleared
  /// whenever a new order is given.
  closeCompletedAt DateTime?

  // -------------------------------------------------------------------------
  // A one-shot rebalance, asked for by hand
  //
  // Deliberately not shaped like the close order above. That one is *standing*:
  // it must survive the position going flat, or the next tick would see idle
  // USDC and undo it. This is the opposite — an operator saying "correct the
  // hedge now" means once, and a flag that stayed set would have the agent
  // re-trading the same legs on every tick for as long as nobody noticed.
  //
  // It lowers the drift threshold to zero for one tick and nothing else. It
  // does not bypass the venue's minimum order notional, which is not a policy
  // this app sets but a fact about Pacifica, and it does not outrank a
  // redemption the vault owes — an operator wanting a tidier hedge does not
  // outrank someone waiting to be paid.
  // -------------------------------------------------------------------------

  /// When an operator asked for a rebalance. Null once served, or never asked.
  rebalanceRequestedAt DateTime?
  /// The admin address that asked, lowercased.
  rebalanceRequestedBy String?
  /// When the agent acted on it — or decided it could not. Always paired with
  /// `rebalanceOutcome`, so the dashboard can say what became of the request
  /// rather than only that it is no longer pending.
  rebalanceCompletedAt DateTime?
  /// What happened, in a sentence: which market was corrected, or why none was.
  rebalanceOutcome     String?

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs    AgentRun[]
  markets VaultMarket[]
  steps   OperatorAction[]

  @@id([chainId, address])
  @@index([ticker])
  @@index([chainId])
}

/// One step of an unwind an operator ran by hand, and what became of it.
///
/// The close order on `VaultConfig` is an instruction to the agent: it is
/// recorded, the agent reads it on its next tick, and the agent does the work.
/// This is the other thing — an operator closing the position themselves,
/// because the agent is stopped, or is on a build that predates the fix they
/// need, or has failed halfway through a close and left one leg open. The API
/// process places the orders directly, using the agent's own venue wiring, and
/// these rows are what happened.
///
/// A row per step rather than a flag per vault, for two reasons. Each step takes
/// minutes — a bridge can take the better part of an hour — so an operator will
/// reload the page while one is running and has to find it again. And the useful
/// half is usually the failure: "the NVDA short is smaller than the venue's lot
/// size, so no order can close it" is the difference between understanding a
/// stuck vault and pressing the button every hour.
model OperatorAction {
  id String @id @default(cuid())

  vaultAddress String
  chainId      Int
  vault        VaultConfig @relation(fields: [chainId, vaultAddress], references: [chainId, address], onDelete: Cascade)

  /// CLOSE_SPOT, CLOSE_PERP, BRIDGE_HOME or RETURN_TO_VAULT.
  step String
  /// RUNNING, DONE, FAILED or ABANDONED.
  ///
  /// ABANDONED is the one that needs saying: these steps run inside an API
  /// process and are not resumed if it restarts, so a row left RUNNING by a
  /// deploy is marked abandoned once its heartbeat goes cold. The venue calls it
  /// had already made stand — abandoned describes the record, not the money.
  status String
  /// The admin address that pressed the button, lowercased.
  requestedBy String
  /// Why, for a close that winds the vault down. Copied onto `VaultConfig` when
  /// the close succeeds, where it outlives this row and the wind-down itself.
  reason String?

  /// `<chainId>:<vault>` while this step is running, null once it has finished.
  ///
  /// The lock, and the reason it is shaped like this: Postgres treats nulls in a
  /// unique index as distinct, so any number of finished rows coexist while a
  /// second running row for the same vault cannot be inserted at all. Two
  /// operators pressing two buttons — or one operator reaching two API
  /// containers — would otherwise put two writers on one agent wallet, which is
  /// a nonce collision on Base and a pair of racing orders at the venue.
  runningKey String? @unique

  /// What happened, in a sentence, for the console to print.
  detail String?
  error  String?
  /// Rows this step published to the vault's public activity feed.
  activityReported Int @default(0)

  startedAt   DateTime  @default(now())
  /// Refreshed while the step runs. A cold one is how an abandoned step is told
  /// apart from a slow bridge, without assuming anything about which process
  /// started it.
  heartbeatAt DateTime  @default(now())
  finishedAt  DateTime?

  @@index([chainId, vaultAddress, startedAt])
}

/// One market a vault runs a basis position in.
///
/// A vault used to be one market by construction, and on-chain it still looks
/// like one: `marketId` is set in the constructor and is immutable. That has
/// always been a *label* rather than a constraint — the contract holds USDC,
/// bounds what the agent may withdraw, and checks the leverage it reports, and
/// none of that is per-market. So which markets the capital is spread across is
/// an off-chain decision, and this is where it is recorded.
///
/// A vault whose row set is `[BTC 40%, ETH 40%, NVDA 20%]` runs three spot legs
/// on Base against three shorts in the *same* Pacifica account. The account is
/// shared deliberately: margin is fungible across symbols there, so splitting it
/// would leave each leg thinly collateralised against its own liquidation price
/// while the account as a whole was comfortable.
///
/// The pairing is by asset and curated, exactly as it is for a single-market
/// vault. Nothing here is resolved from a ticker at trade time.
model VaultMarket {
  id String @id @default(cuid())

  /// The vault this market belongs to, lowercased, and the chain it is on.
  vaultAddress String
  chainId      Int         @default(8453)
  vault        VaultConfig @relation(fields: [chainId, vaultAddress], references: [chainId, address], onDelete: Cascade)

  /// The market's ticker, e.g. "NVDA". Unique within the vault.
  ticker String

  /// The ERC-20 that is this market's spot leg, and its decimals.
  ///
  /// On the chain the *spot leg* trades on, which is not necessarily the chain
  /// the vault custodies on — see the note on cross-chain spot in the agent.
  spotTokenAddress  String
  spotTokenDecimals Int
  spotTokenSymbol   String

  /// What Pacifica accepts on the wire for this market's perp leg.
  perpSymbol String

  /// The share of the vault's spot notional this market should carry, in basis
  /// points. The enabled rows sum to 10000.
  ///
  /// A target rather than a holding. The agent deploys into whichever enabled
  /// market is furthest below its share, one market per tick, which converges on
  /// these weights without ever needing an atomic multi-market trade — there is
  /// no such thing across two chains and a third venue's matching engine.
  targetWeightBps Int @default(10000)

  /// Whether new capital may go into this market.
  ///
  /// Disabling is how a market is retired, and deleting the row is not offered.
  /// A vault can hold a position in a market an operator has changed their mind
  /// about, and a deleted row is a position the agent can no longer see, value,
  /// or sell. Disabled instead: its target weight is treated as zero, which
  /// makes it the most overweight market there is, so the next unwind drains it
  /// first and a close order sells it like any other.
  enabled Boolean @default(true)

  /// Set when this row was seeded from `VaultConfig`'s founding-market columns
  /// rather than chosen by an operator, so a vault created before vaults had
  /// more than one market is distinguishable from one deliberately given a
  /// single market.
  seeded Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chainId, vaultAddress, ticker])
  @@index([chainId, vaultAddress, enabled])
}

/// One leg of a cross-chain USDC move, while it is in the air.
///
/// A bridge is the only part of a tick that outlives the process running it.
/// USDC that has left Base and not yet arrived on Solana belongs to the vault
/// but sits in neither balance the valuation can read, and an agent restarted
/// during that window would report a NAV missing the whole transfer — a dip and
/// a recovery that never happened, written into every holder's share price.
///
/// So the in-flight amount is persisted rather than held in memory, and the
/// valuation adds it back. The row is also the audit trail for a bridge that
/// never lands: a `SENT` row older than the venue's fill time is a stranded
/// transfer with a Relay request id to chase it by.
model BridgeTransfer {
  id String @id @default(cuid())

  /// The vault whose capital this is, lowercased, and the chain it custodies on.
  vaultAddress String
  chainId      Int @default(8453)

  /// TO_SOLANA (margin out) or TO_BASE (margin home).
  ///
  /// TO_BASE is a historical name that now means "home to the vault's custody
  /// chain", whichever that is. Left as-is rather than renamed: the string is
  /// persisted in every existing row, and a rename is a data migration whose
  /// only benefit is the name.
  direction String

  /// Relay's identifier for the intent, which is what its status endpoint takes.
  requestId String

  /// The address Relay asked us to send to, on the origin chain.
  depositAddress String

  /// Sent, in USDC base units. A string because six-decimal amounts are exact
  /// as integers and lossy as doubles.
  amountUsdc String

  /// Filled on the destination chain, once known. Always less than what was
  /// sent — the difference is the relayer's cut, and it is recorded as a fee.
  landedUsdc String?

  /// PENDING (quoted, not yet sent), SENT (origin transaction confirmed),
  /// COMPLETE (filled), FAILED (refunded or given up on).
  status String @default("PENDING")

  /// The origin-chain transaction that funded the deposit address.
  sendTxRef String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainId, vaultAddress, status])
}

/// One tick of one agent, kept for review.
///
/// The agent is the only party that can move deployed capital, and most of what
/// it does is a judgement call about timing. Recording the decision and its
/// stated reason is what makes "why did the vault sit idle through a good
/// funding window" a question with an answer.
model AgentRun {
  id String @id @default(cuid())

  vaultAddress String
  chainId      Int         @default(8453)
  vault        VaultConfig @relation(fields: [chainId, vaultAddress], references: [chainId, address], onDelete: Cascade)

  /// DEPLOY, UNWIND, REBALANCE, TOP_UP_MARGIN, HOLD or NONE.
  ///
  /// Older rows also carry CLOSE_ALL, from when a standing close order was
  /// carried out by the agent. Closing is the console's own action now — see
  /// `OperatorAction` — and no new run records it.
  action String
  /// Which of the vault's markets the action was aimed at, when it was aimed at
  /// one. Null for the actions that are about the vault rather than a market —
  /// HOLD, an UNWIND, which takes from whichever markets are furthest above
  /// their target weight rather than from a market the policy named, and a
  /// TOP_UP_MARGIN, which pays into the one account backing every market.
  market String?
  /// The reason given — by the policy, or by the advisory model when consulted.
  rationale String

  /// Whether a language model chose among the permitted actions on this tick.
  /// The distinction matters when reviewing: an unadvised run is fully
  /// explained by the policy, an advised one is not.
  advised Boolean @default(false)

  navReported      Boolean @default(false)
  activityReported Int     @default(0)
  fulfilled        Int     @default(0)
  error            String?

  createdAt DateTime @default(now())

  @@index([chainId, vaultAddress, createdAt])
  @@index([createdAt])
}

/// The result of checking one reported action against the chain it names.
///
/// Kept here rather than in the indexer because a Ponder resync drops and
/// rebuilds every table from Base events, and these verdicts are not derivable
/// from Base events — they come from Solana RPC and from block explorers. Storing
/// them there would silently discard the entire audit history on any reindex.
model ActivityVerification {
  /// `<chainId>-<vault>-<sequence>`, matching the indexer's activity id.
  id String @id

  vaultAddress String
  chainId      Int @default(8453)
  sequence     Int

  /// Null while unchecked. False is a much stronger statement than silence: it
  /// means the transaction the agent named does not support what it claimed.
  verified Boolean?
  /// What was checked and what was found, in plain language, for the UI.
  note     String?

  /// Attempts so far. A permanently unreachable chain should stop being retried
  /// rather than becoming an endless background load.
  attempts    Int       @default(0)
  lastAttempt DateTime?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([chainId, vaultAddress, sequence])
  @@index([verified])
}

/// An address permitted to administer the protocol.
///
/// Deliberately a database row rather than an environment variable. Admin
/// membership changes, and a change that needs a redeploy is a change that gets
/// made by editing a running container instead.
model AdminUser {
  address String @id

  /// Whether this admin may create vaults, as opposed to only reading the
  /// dashboard. Creating a vault commits real capital to a market pairing.
  canCreateVaults Boolean @default(false)

  label     String?
  addedBy   String?
  createdAt DateTime @default(now())
}
