// Persistence for state that cannot be reconstructed from chain or upstream APIs.
//
// Deliberately narrow: Pacifica owns perp positions, KyberSwap owns spot limit
// orders, and the chain owns balances. The only things stored here are the
// multi-leg basis positions (which span two independent systems and can
// half-fail), Relay deposit tracking, and cached market state.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cached registry of spot legs — Coinbase B20 tokenized stocks and the Base
/// ERC-20s that match a listed perp — plus their live routability.
model SpotAsset {
  symbol           String   @id
  ticker           String   @unique
  name             String
  address          String   @unique
  decimals         Int
  /// The perp market that hedges this token, resolved by ticker against the
  /// live catalog and refreshed on sync. Null means nothing lists a match, so
  /// the token has no basis market.
  perpSymbol String?

  /// Whether KyberSwap can currently route into / out of this token. This is
  /// live market state, not configuration — most of these tokens have no
  /// Aerodrome pool yet, and that changes without notice.
  buyable              Boolean  @default(false)
  sellable             Boolean  @default(false)
  buyPriceImpactPct    Float?
  /// Executable USD price from the last buy probe, which is what the basis is
  /// measured against.
  spotPriceUsd         Float?
  routabilityCheckedAt DateTime?

  updatedAt DateTime @updatedAt

  positions BasisPosition[]

  @@index([buyable])
}

enum BasisStatus {
  /// Both legs quoted and validated, nothing signed yet.
  VALIDATING
  /// Spot bought; the short leg has not landed. Directionally exposed.
  SPOT_FILLED
  /// Both legs live and delta-neutral.
  OPEN
  /// Unwind started.
  UNWINDING
  /// Spot sold during unwind; short still open.
  SPOT_CLOSED
  CLOSED
  /// One leg landed and its counterpart failed. Needs user action.
  ORPHANED
  FAILED
}

enum BasisLeg {
  SPOT
  PERP
}

/// A delta-neutral basis position: long the spot token, short the matching perp.
model BasisPosition {
  id           String      @id @default(cuid())
  userAddress  String
  tokenSymbol  String
  token        SpotAsset   @relation(fields: [tokenSymbol], references: [symbol])

  /// Snapshotted at open for display. The market is always re-resolved by
  /// symbol before trading, never read from here.
  perpSymbol String

  status BasisStatus @default(VALIDATING)

  /// Target notional for each leg. Equal notionals are what make it neutral.
  notionalUsd       Float
  shares            Float?
  spotCostUsd       Float?
  perpCollateralUsd Float
  perpLeverage      Float

  /// Economics captured at open, so the position card can show drift since.
  entryFundingRatePct Float?
  entryNetApyPct      Float?

  spotBuyTxHash   String?
  perpOpenTxHash  String?
  spotSellTxHash  String?
  perpCloseTxHash String?

  realizedPnlUsd Float?
  /// Set when a leg fails, to explain the ORPHANED state to the user.
  failureReason  String?

  openedAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  events BasisLegEvent[]

  @@index([userAddress, status])
  @@index([status])
}

/// Append-only audit of every leg action.
///
/// Opening a position touches two independent systems, so a crash between them leaves
/// state that cannot be inferred afterwards. Recording each attempt is what
/// makes an interrupted open recoverable rather than silently lost.
model BasisLegEvent {
  id         String        @id @default(cuid())
  positionId String
  position   BasisPosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  leg     BasisLeg
  action  String
  status  String
  txHash  String?
  /// Venue order id, when the leg was placed through an API rather than a
  /// chain transaction.
  trackingId String?
  error   String?
  payload Json?

  createdAt DateTime @default(now())

  @@index([positionId, createdAt])
}

enum DepositStatus {
  PENDING
  DETECTED
  COMPLETE
  FAILED
  REFUNDED
}

/// A Relay deposit address issued to fund an account with USDC on Base.
model DepositIntent {
  id             String        @id @default(cuid())
  userAddress    String
  requestId      String        @unique
  depositAddress String
  originChainId  Int
  originCurrency String
  originSymbol   String
  amount         String
  amountFormatted String?
  status         DepositStatus @default(PENDING)
  inTxHash       String?
  outTxHash      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userAddress, status])
  @@index([depositAddress])
}

/// Only the spot leg produces a chain transaction, so it is the only thing a
/// client can claim. Positions opened are counted from `BasisPosition` rows
/// directly, which cannot be forged by a POST.
enum PointsSource {
  SPOT_VOLUME
}

/// A verified, points-earning action.
///
/// `txHash` is unique, which is what makes recording idempotent: the client
/// reports a hash after its wallet confirms, and replaying the same hash — by
/// retry, refresh, or deliberately — cannot award points twice.
///
/// Nothing is written here on a client's say-so. Swaps are verified against the
/// chain first (sender, success, and the router actually called), because the
/// app only builds calldata — the wallet submits it, so an unverified report
/// would let anyone mint points with a POST.
model PointsEvent {
  id          String       @id @default(cuid())
  userAddress String
  source      PointsSource
  /// Notional in USD, for volume-based sources.
  volumeUsd   Float        @default(0)
  points      Int
  txHash      String?      @unique
  /// Verification evidence: block number and the contract that was called.
  blockNumber Int?
  target      String?
  createdAt   DateTime     @default(now())

  @@index([userAddress, createdAt])
  @@index([source])
}

/// Periodic funding snapshots, so a market's APR can be shown as a trend rather
/// than a single instantaneous reading that swings with open interest.
model FundingSnapshot {
  id           String   @id @default(cuid())
  pairIndex    Int
  symbol       String
  /// Percent per hour. Positive = the side receives, negative = it pays.
  longRatePct  Float
  shortRatePct Float
  longOi       Float
  shortOi      Float
  capturedAt   DateTime @default(now())

  @@index([symbol, capturedAt])
  @@index([pairIndex, capturedAt])
}

// ---------------------------------------------------------------------------
// Accounts
//
// Sign-in binds a connected wallet to a pair of NEAR-derived wallets and a
// Pacifica account. None of that is reconstructible from chain state: the
// derived addresses come from a path, and the Pacifica agent key exists only
// here, so this is the one record whose loss locks a user out of their own
// positions.
// ---------------------------------------------------------------------------

/// A signed-in user, keyed by the wallet they connect with.
model User {
  id String @id @default(cuid())

  /// The connected wallet, lowercased. This is the user's identity everywhere
  /// in the app; the derived addresses below are infrastructure they never see.
  address String @unique

  /// NEAR chain-signature derivation path. Written once at first sign-in and
  /// never recomputed — the format is versioned precisely so that a change to
  /// the derivation scheme cannot silently repoint an existing user at empty
  /// wallets. See `@lemon/near-mpc`'s `derivationPath`.
  derivationPath String @unique

  /// Ed25519 address the path controls. Also the Pacifica account id.
  solanaAddress String @unique
  /// secp256k1 address the same path controls, held for future EVM use.
  derivedEvmAddress String

  /// Agent wallet authorised to trade for `solanaAddress`.
  ///
  /// Binding it is the only operation that needs the account key itself, so it
  /// is the only one that costs an MPC round trip. Ordinary orders are signed
  /// locally with this key, which is what keeps trading fast.
  pacificaAgentPublicKey String?
  /// The agent's secret key, sealed with AUTH_SECRET (AES-256-GCM). Ciphertext
  /// alone is not enough to trade; the database and the secret must both leak.
  pacificaAgentSecret String?
  pacificaBoundAt     DateTime?

  /// The builder code this user approved, and the fee ceiling they set.
  ///
  /// Both are recorded because an approval is only good for the exact pair.
  /// Pacifica rejects an order whose builder fee exceeds the approved ceiling
  /// rather than filling it unattributed, so raising the configured rate past
  /// what a user approved would stop them trading. Storing what they agreed to
  /// is what lets the app notice the mismatch and ask again instead.
  pacificaBuilderCode       String?
  pacificaBuilderMaxFeeRate String?
  pacificaBuilderApprovedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  deposits PacificaDeposit[]
}

/// A browser session, established by a wallet signature.
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the bearer token. The token itself is never stored, so a
  /// database leak cannot be replayed as a live session.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A one-time challenge, issued before each signature the app asks for.
///
/// Single-use and short-lived: without this a captured signature would be a
/// permanent credential, replayable by anyone who saw it once.
model SignInNonce {
  nonce String @id

  /// Lowercased wallet the challenge was issued to.
  address String
  /// Which step the challenge is for — a sign-in signature must not be
  /// replayable as a Pacifica activation, or vice versa.
  purpose String

  /// The exact text the wallet was asked to sign.
  ///
  /// Stored rather than reconstructed at verification time. The message embeds
  /// a timestamp, and rebuilding it means reproducing that timestamp to the
  /// millisecond — a signature that fails to verify because two clocks
  /// disagree is indistinguishable from an attack.
  message String

  /// Sealed state the challenge carries between the two requests it spans.
  ///
  /// Pacifica activation generates an agent key when the challenge is issued,
  /// because the key has to be named in the text the user signs. Parking it
  /// here rather than on the user keeps an unbound key from overwriting the
  /// working one if activation is abandoned half way.
  payload String?

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address, purpose])
  @@index([expiresAt])
}

enum PacificaDepositStatus {
  /// Relay is moving USDC from the connected wallet's chain to Solana.
  BRIDGING
  /// USDC has landed at the derived Solana wallet but is not yet Pacifica's.
  BRIDGED
  /// The on-chain deposit instruction has been submitted.
  CREDITING
  CREDITED
  FAILED
}

/// Funding a Pacifica account, tracked across the two steps it takes.
///
/// Bridging and crediting are separate transactions on separate chains, and the
/// gap between them is where money can sit looking lost: it has left the
/// connected wallet but is not yet a Pacifica balance. Recording the transition
/// is what lets the accounts page explain that state instead of showing zero.
model PacificaDeposit {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  amountUsdc Float

  /// Relay's id for the bridge leg, when the funds came from another chain.
  relayRequestId String?
  /// The Pacifica `deposit` instruction, once broadcast. Unique, so a retried
  /// credit cannot be recorded twice.
  solanaTxSignature String? @unique

  status        PacificaDepositStatus @default(BRIDGING)
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
}
