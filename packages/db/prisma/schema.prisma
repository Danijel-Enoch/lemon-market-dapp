// Persistence for state that cannot be reconstructed from chain or upstream APIs.
//
// Narrower than it looks, because most of what the app shows is not here. The
// vaults, their balances, every deposit and withdrawal and every action the
// agents took live on Base and are read through Ponder — a database that can be
// dropped and rebuilt from events. This one holds the four things that genuinely
// cannot be:
//
//   1. Sessions and the wallets they are bound to.
//   2. Which addresses may administer the protocol.
//   3. The venue configuration a vault trades against, which is a curated
//      mapping from a market to a specific token and perp and is not on-chain.
//   4. Verdicts from verifying agent activity against other chains, which are
//      the product of round trips that a reindex would otherwise discard.
//
// Nothing a user's balance depends on is stored here. Losing this database
// costs sessions and operator configuration; it cannot cost anyone their funds.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Cached registry of spot legs — Coinbase B20 tokenized stocks and the Base
/// ERC-20s that match a listed perp — plus their live routability.
model SpotAsset {
  symbol           String   @id
  ticker           String   @unique
  name             String
  address          String   @unique
  decimals         Int
  /// The perp market that hedges this token, resolved by ticker against the
  /// live catalog and refreshed on sync. Null means nothing lists a match, so
  /// the token has no basis market.
  perpSymbol String?

  /// Whether KyberSwap can currently route into / out of this token. This is
  /// live market state, not configuration — most of these tokens have no
  /// Aerodrome pool yet, and that changes without notice.
  buyable              Boolean  @default(false)
  sellable             Boolean  @default(false)
  buyPriceImpactPct    Float?
  /// Executable USD price from the last buy probe, which is what the basis is
  /// measured against.
  spotPriceUsd         Float?
  routabilityCheckedAt DateTime?

  updatedAt DateTime @updatedAt

  @@index([buyable])
}

/// Periodic funding snapshots, so a market's APR can be shown as a trend rather
/// than a single instantaneous reading that swings with open interest.
model FundingSnapshot {
  id           String   @id @default(cuid())
  pairIndex    Int
  symbol       String
  /// Percent per hour. Positive = the side receives, negative = it pays.
  longRatePct  Float
  shortRatePct Float
  longOi       Float
  shortOi      Float
  capturedAt   DateTime @default(now())

  @@index([symbol, capturedAt])
  @@index([pairIndex, capturedAt])
}

// ---------------------------------------------------------------------------
// Accounts
//
// Sign-in exists to answer one question: which wallet is this. Users do not
// trade through the app any more — they deposit USDC into a vault and hold an
// ERC-20 share, both of which are ordinary wallet actions needing no session at
// all. What a session gates is the admin dashboard, and the convenience of
// showing someone their own portfolio without typing an address.
//
// So unlike the previous design, losing this table locks nobody out of
// anything. A user's position is their share balance on Base; it is theirs
// whether or not this database exists.
// ---------------------------------------------------------------------------

/// A signed-in user, keyed by the wallet they connect with.
model User {
  id String @id @default(cuid())

  /// The connected wallet, lowercased. This is the user's identity everywhere
  /// in the app; the derived addresses below are infrastructure they never see.
  address String @unique

  /// Whether this address is an admin, denormalised from `AdminUser` so the
  /// session lookup does not need a second query on every request.
  isAdmin Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
}

/// A browser session, established by a wallet signature.
model Session {
  id String @id @default(cuid())

  /// SHA-256 of the bearer token. The token itself is never stored, so a
  /// database leak cannot be replayed as a live session.
  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/// A one-time challenge, issued before each signature the app asks for.
///
/// Single-use and short-lived: without this a captured signature would be a
/// permanent credential, replayable by anyone who saw it once.
model SignInNonce {
  nonce String @id

  /// Lowercased wallet the challenge was issued to.
  address String
  /// Which step the challenge is for. Kept even though sign-in is currently the
  /// only purpose: a challenge issued for one action must never be replayable as
  /// another, and adding the field back later means migrating live nonces.
  purpose String

  /// The exact text the wallet was asked to sign.
  ///
  /// Stored rather than reconstructed at verification time. The message embeds
  /// a timestamp, and rebuilding it means reproducing that timestamp to the
  /// millisecond — a signature that fails to verify because two clocks
  /// disagree is indistinguishable from an attack.
  message String

  /// Sealed state a challenge carries between the two requests it spans.
  payload String?

  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([address, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Vaults
//
// The on-chain vault is the source of truth for money. What it cannot hold is
// which *actual assets* a market means — the vault knows `keccak256("NVDA")`
// and nothing else, and resolving that to a Base ERC-20 and a Pacifica symbol
// is a curated decision that must not be guessable from a ticker.
// ---------------------------------------------------------------------------

enum RiskTier {
  CONSERVATIVE
  LEVERAGED
}

/// What kind of thing a vault trades.
///
/// Finer than the four tabs the board shows, because metals and commodities are
/// genuinely different instruments even though a depositor choosing a vault
/// groups them together. `@lemon/core` owns the mapping from these to tabs.
enum VaultAssetClass {
  CRYPTO
  EQUITY
  RWA
  FX
  COMMODITY
  METAL
  INDEX
  UNKNOWN
}

/// Venue configuration for one deployed vault, and the record of how it was created.
///
/// The pairing here is by asset, never by ticker match. A plain symbol lookup
/// against a Base token list returns an unrelated Base-native token for
/// FARTCOIN, a governance token for DOGE, and a different issuer's tokenized
/// stock for STRK — each of which would hedge a vault against the wrong asset
/// while every dashboard read healthy. The agent refuses to trade a vault with
/// no row here rather than resolving one itself.
model VaultConfig {
  /// The deployed vault address, lowercased.
  address String @id

  /// Ticker the vault was created for, e.g. "NVDA". `keccak256` of this is the
  /// on-chain `marketId`, which is one-way — so this is the only place the
  /// human-readable name survives.
  ticker String

  riskTier RiskTier

  /// Set when the vault is created, from the market it was created for. Null
  /// falls back to the curated ticker table in `@lemon/core`, so an older row
  /// still lands in the right tab.
  assetClass VaultAssetClass?

  /// The NEAR derivation path this vault's agent wallet lives at. Recorded
  /// rather than recomputed so a change to the derivation scheme is visible as
  /// a mismatch instead of silently repointing an agent at empty wallets.
  agentPath       String @unique
  agentEvmAddress String @unique
  agentSolanaAddress String @unique

  /// The Base ERC-20 that is the spot leg, and its decimals.
  spotTokenAddress  String
  spotTokenDecimals Int
  spotTokenSymbol   String

  /// What Pacifica accepts on the wire for the perp leg, e.g. "NVDA".
  perpSymbol String

  /// Slippage the agent trades with, as a percent. 0.5 means 0.5%.
  slippagePercent Float @default(0.5)

  /// Set when an operator has deliberately stopped the agent trading this vault
  /// without pausing the contract, which would also stop users depositing.
  agentEnabled Boolean @default(true)

  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  runs  AgentRun[]

  @@index([ticker])
}

/// A paper position, for a deployment where the venues are read but not traded.
///
/// Exists because the legs have to persist across restarts. A real agent reads
/// its position back from Kyber and Pacifica; a paper one has nowhere to read it
/// from, and holding it in memory would mean every restart silently flattened a
/// vault that the chain still believes is deployed.
///
/// Amounts are strings, not floats. Spot units carry the token's own decimals
/// and USDC carries six; a position parsed through a double loses precision
/// well before it reaches a NAV report.
model PaperPosition {
  /// The vault this position belongs to, lowercased.
  vaultAddress String @id

  /// Spot tokens the agent would be holding, in the token's own decimals.
  spotUnits String @default("0")
  /// USDC actually spent acquiring them, so realised spot P&L is knowable.
  spotCostUsdc String @default("0")

  /// Size of the short, in the same units as the spot leg — delta-neutral means
  /// these two track each other, and the gap between them is the thing to watch.
  perpUnits String @default("0")
  /// Margin posted against it, in USDC units.
  perpMarginUsdc String @default("0")
  /// Mark price the short was opened at, scaled by 1e6.
  perpEntryPriceE6 String @default("0")

  /// Funding accrued since the position opened, in USDC units. Signed: a basis
  /// trade that stops paying is the case worth being able to show.
  fundingAccruedUsdc String @default("0")
  /// When funding was last accrued, so a tick charges only the elapsed hours.
  fundingAccruedAt DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// One tick of one agent, kept for review.
///
/// The agent is the only party that can move deployed capital, and most of what
/// it does is a judgement call about timing. Recording the decision and its
/// stated reason is what makes "why did the vault sit idle through a good
/// funding window" a question with an answer.
model AgentRun {
  id String @id @default(cuid())

  vaultAddress String
  vault        VaultConfig @relation(fields: [vaultAddress], references: [address], onDelete: Cascade)

  /// DEPLOY, UNWIND, REBALANCE, HOLD or NONE.
  action String
  /// The reason given — by the policy, or by the advisory model when consulted.
  rationale String

  /// Whether a language model chose among the permitted actions on this tick.
  /// The distinction matters when reviewing: an unadvised run is fully
  /// explained by the policy, an advised one is not.
  advised Boolean @default(false)

  navReported      Boolean @default(false)
  activityReported Int     @default(0)
  fulfilled        Int     @default(0)
  error            String?

  createdAt DateTime @default(now())

  @@index([vaultAddress, createdAt])
  @@index([createdAt])
}

/// The result of checking one reported action against the chain it names.
///
/// Kept here rather than in the indexer because a Ponder resync drops and
/// rebuilds every table from Base events, and these verdicts are not derivable
/// from Base events — they come from Solana RPC and from block explorers. Storing
/// them there would silently discard the entire audit history on any reindex.
model ActivityVerification {
  /// `<vault>-<sequence>`, matching the indexer's activity id.
  id String @id

  vaultAddress String
  sequence     Int

  /// Null while unchecked. False is a much stronger statement than silence: it
  /// means the transaction the agent named does not support what it claimed.
  verified Boolean?
  /// What was checked and what was found, in plain language, for the UI.
  note     String?

  /// Attempts so far. A permanently unreachable chain should stop being retried
  /// rather than becoming an endless background load.
  attempts    Int       @default(0)
  lastAttempt DateTime?
  verifiedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vaultAddress, sequence])
  @@index([verified])
}

/// An address permitted to administer the protocol.
///
/// Deliberately a database row rather than an environment variable. Admin
/// membership changes, and a change that needs a redeploy is a change that gets
/// made by editing a running container instead.
model AdminUser {
  address String @id

  /// Whether this admin may create vaults, as opposed to only reading the
  /// dashboard. Creating a vault commits real capital to a market pairing.
  canCreateVaults Boolean @default(false)

  label     String?
  addedBy   String?
  createdAt DateTime @default(now())
}
